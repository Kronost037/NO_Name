theme Nightfall active {
    background: #0b1020
    panel: #171f35
    panel_alt: #202a45
    accent: #6c8cff
    accent_bright: #9f7aea
    button: #2b416f
    button_hover: #42629d
    button_pressed: #20345c
    text: #8f96a7
    muted: #a8b5d3
    success: #42d3a2
    border: #2d3b60
    button_border: #5474b5
}

component Brand {
    width: 900
    height: 88
    layout: vertical
    gap: 4

    Text {
        height: 44
        content: "DECLARATIVE UI"
        font_size: 34
        letter_spacing: 5
        text_color: $text
    }

    Text {
        height: 26
        content: "A visual language for calm, precise interfaces"
        font_size: 16
        letter_spacing: 3
        text_color: $muted
    }
}

component StatusCard {
    width: 340
    height: 200
    padding: 24
    background: $panel
    radius: 16
    border_color: $border
    border_width: 1
    layout: vertical
    gap: 10

    Text {
        height: 30
        content: "LIVE CANVAS"
        font_size: 21
        letter_spacing: 5
        text_color: $accent
    }

    Text {
        height: 76
        content: "Components, themes and layout are resolved in real time."
        font_size: 15
        line_height: 24
        letter_spacing: 2.25
        text_color: $text
    }

    Text {
        height: 20
        content: "STATUS: ONLINE"
        font_size: 16
        letter_spacing: 5
        text_color: $success
    }
}

component GuideCard {
    width: 340
    height: 200
    padding: 24
    background: $panel_alt
    radius: 16
    border_color: $border
    border_width: 1
    layout: vertical
    gap: 10

    Text {
        height: 30
        content: "READY TO CREATE"
        font_size: 21
        letter_spacing: 5
        text_color: $accent_bright
    }

    Text {
        height: 76
        content: "Choose an action on the right and start building your next interface."
        font_size: 15
        line_height: 24
        letter_spacing: 2.5
        text_color: $text
    }

    Text {
        height: 20
        content: "TIP: HOVER OVER A BUTTON"
        font_size: 12
        letter_spacing: 5
        text_color: $muted
    }
}

component AccentRail {
    width: 8
    height: 420
    background: $accent
    radius: 4
}

component Menu {
    width: 360
    height: 410
    padding: 28
    background: $panel_alt
    radius: 20
    border_color: $border
    border_width: 1
    layout: vertical
    gap: 12

    Text {
        height: 48
        content: "CONTROL DECK"
        font_size: 29
        letter_spacing: 5
        text_color: $text
        text_align: center
    }

    Text {
        height: 30
        content: "Choose your next move"
        font_size: 14
        letter_spacing: 3
        text_color: $muted
        text_align: center
    }

    Button {
        width: 304
        height: 48
        background: $button
        radius: 10
        border_color: $button_border
        border_width: 1
        content: "New"
        font_size: 18
        letter_spacing: 3
        text_color: $text
        text_align: center
        text_vertical_align: middle
        hover {
            background: $button_hover
        }
        pressed {
            background: $button_pressed
        }
    }

    Button {
        width: 304
        height: 48
        background: $button
        radius: 10
        border_color: $button_border
        border_width: 1
        content: "Open Project"
        font_size: 18
        letter_spacing: 3
        text_color: $text
        text_align: center
        text_vertical_align: middle
        hover {
            background: $button_hover
        }
        pressed {
            background: $button_pressed
        }
    }

    Button {
        width: 304
        height: 48
        background: $button
        radius: 10
        border_color: $button_border
        border_width: 1
        content: "Studio"
        font_size: 18
        letter_spacing: 3
        text_color: $text
        text_align: center
        text_vertical_align: middle
        hover {
            background: $button_hover
        }
        pressed {
            background: $button_pressed
        }
    }

    Button {
        width: 304
        height: 48
        background: $button
        radius: 10
        border_color: $button_border
        border_width: 1
        content: "Dashboard"
        font_size: 18
        letter_spacing: 3
        text_color: $text
        text_align: center
        text_vertical_align: middle
        hover {
            background: $button_hover
        }
        pressed {
            background: $button_pressed
        }
    }
}

component Footer {
    width: 620
    height: 26
    layout: vertical

    Text {
        height: 26
        content: "NIGHTFALL THEME  /  V0.1  /  TEST"
        font_size: 12
        letter_spacing: 3
        text_color: $muted
    }
}

screen MainMenu active {
    width: 1280
    height: 800
    background: $background
    layout: free

    Brand #brand {
        x: 110
        y: 72
    }

    StatusCard #status {
        x: 110
        y: 202
    }

    GuideCard #guide {
        x: 110
        y: 432
    }

    AccentRail #accent_rail {
        x: 620
        y: 170
    }

    Menu #mainmenu {
        x: 670
        y: 170
    }

    Footer #footer {
        x: 110
        y: 704
    }
}
